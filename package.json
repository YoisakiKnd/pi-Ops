{
  "name": "pi-ops",
  "version": "0.1.3",
  "description": "Ops operator for Pi: persistent memory, scheduled checks and multi-session reporting",
  "type": "module",
  "files": [
    "index.ts",
    "src",
    "daemon.cjs",
    "cli.cjs",
    "setup.cjs",
    "service.cjs",
    "README.md",
    "ARCHITECTURE.md",
    "MIGRATION.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "ops": "node cli.cjs",
    "test": "node --test test/*.test.cjs",
    "syntax": "node scripts/check-syntax.cjs",
    "typecheck": "tsc --noEmit",
    "check": "npm run syntax && npm run typecheck && npm test"
  },
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": ">=1.5.0",
    "typebox": "*"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "keywords": [
    "pi",
    "pi-package",
    "pi-extension",
    "ops",
    "telegram",
    "memory",
    "cron"
  ],
  "license": "MIT",
  "dependencies": {
    "markdown-it": "^14.1.0",
    "string-width": "^8.1.1"
  }
}
